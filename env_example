# the port in the server firewall. The dashboard has no authentication, so
# only expose it on a trusted network or behind a proxy / SSH tunnel.
# ─────────────────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000
