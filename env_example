### === WEB CRABLER CONFIG ===
# WebCrawler tuning (modules/recon/WebCrawler.py) — all optional, defaults shown.

# How many *unproductive* URLs sharing the same path+param-names pattern
# (e.g. ?bID=1, ?bID=2, ...) get crawled before later ones are skipped as
# duplicates. A variant that surfaces new in-scope links is never counted
# against this budget, however many there are — only ones that fetch-fail
# or lead nowhere new count. Raise to test more values per parameter at the
# cost of crawl time; lower to crawl faster at the cost of coverage.
CRAWLER_MAX_URL_PATTERN_VARIANTS=5

# Max same-host redirects fetch_page() will follow for a single page before
# giving up and keeping the last in-scope response. A redirect leaving scope
# (different host) is never followed regardless of this limit.
CRAWLER_MAX_REDIRECT_HOPS=10

# Relaxes TLS (SECLEVEL=0, allows TLSv1.0) for https:// requests so ancient
# servers that modern OpenSSL refuses by default (e.g. Apache/OpenSSL 0.9.8k
# on the OWASP-BWA VM) can still be crawled. Set to false to use normal TLS
# validation instead (https targets with only legacy TLS will then fail to
# fetch rather than being crawled with weakened security).
CRAWLER_LEGACY_TLS=true

# Comma-separated user:password pairs tried against an HTTP Basic Auth
# challenge (401 + WWW-Authenticate: Basic) before giving up on a page - e.g.
# Java WebGoat gates its whole app behind guest/guest, so without this every
# page past that 401 is invisible to the crawler. Once a pair works it's
# reused for the rest of that app's session (see _session_for).
CRAWLER_BASIC_AUTH_CREDENTIALS=guest:guest,webgoat:webgoat,admin:admin,tomcat:tomcat,admin:password


# ─────────────────────────────────────────────────────────────────────────
