#!/bin/bash
### BEGIN INIT INFO
# Provides:          sqli
# Required-Start:    $network $local_fs mysql
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: SQLiAgent orchestrator
# Description:       Pipeline monitor (SQLiAgentOrchestrator) — launches WebCrawler/WebDetector/etc per job and the web dashboard
### END INIT INFO

# Absolute path to the application copy this service runs. Adjust APPDIR and
# RUN_USER for your deployment. RUN_USER must own / be able to traverse APPDIR:
# a home directory like /home/<user> is usually drwxr-x--- and NOT traversable
# by www-data, so use the owning user (not www-data) when APPDIR lives there.
APPDIR="/home/usuario/2. SQLCortex"
DAEMON=/usr/bin/python3
SCRIPT="$APPDIR/src/SQLiAgentOrchestrator.py"
LOGFILE="$APPDIR/sqli-service.log"
PIDFILE=/var/run/sqli.pid
NAME=sqli
RUN_USER=usuario

case "$1" in
    start)
        echo "Starting $NAME..."
        start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
            --chuid "$RUN_USER" --chdir "$APPDIR/src" \
            --startas /bin/bash -- -c "export PYTHONPATH='$APPDIR/src'; exec '$DAEMON' '$SCRIPT' --monitor-all >> '$LOGFILE' 2>&1"
        echo "$NAME started (log: $LOGFILE)."
        ;;
    stop)
        echo "Stopping $NAME..."
        start-stop-daemon --stop --pidfile "$PIDFILE" --retry 10
        rm -f "$PIDFILE"
        echo "$NAME stopped."
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "$NAME is running (PID $(cat "$PIDFILE"))"
        else
            echo "$NAME is not running"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
